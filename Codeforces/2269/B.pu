def nxt(n):
    total = 0

    while n > 0:
        digit = n % 10
        total += digit * digit
        n //= 10

    return total


def get_state(n):
    seen = set()

    while n not in seen:
        if n == 1:
            return 1

        seen.add(n)
        n = nxt(n)

    return n


t = int(input())

for _ in range(t):
    n = int(input())
    arr = list(map(int, input().split()))

    count = {}

    for x in arr:
        state = get_state(x)
        count[state] = count.get(state, 0) + 1

    ans = 0

    for c in count.values():
        ans += c * (c - 1) // 2

    print(ans)